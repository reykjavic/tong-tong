# WhatsApp webhook — Milestone 0 secrets (LOCAL ONLY, gitignored).
# Copy this file to backend/.env.whatsapp and fill in the Meta values.
# scripts/deploy-whatsapp.sh passes these to SAM as CloudFormation parameters,
# which become Lambda environment variables. See backend/README.md for where to
# find each value in the Meta dashboard.

# A token YOU invent. It must also be entered in the Meta App Dashboard
# (Webhooks -> WhatsApp -> Configure) so the GET verification handshake works.
VERIFY_TOKEN=change-me

# Permanent / system-user access token for the Graph API.
# Meta App Dashboard -> WhatsApp -> Configuration -> API Setup.
META_ACCESS_TOKEN=change-me

# Numeric ID of the WhatsApp Business number that sends the replies.
# Meta App Dashboard -> WhatsApp -> Configuration -> Phone number ID.
PHONE_NUMBER_ID=change-me

# Meta App secret — HMAC key used to verify X-Hub-Signature-256.
# Meta App Dashboard -> App settings -> Basic -> App secret.
APP_SECRET=change-me

# Optional: fixed auto-reply text. If omitted, the bot echoes the received
# message back — a good first smoke test. Example:
#AUTO_REPLY_TEXT=Hallo! Vielen Dank für Ihre Nachricht. Wir antworten gleich.

# Optional: Graph API version. Defaults to v25.0 — bump when Meta deprecates it.
#GRAPH_API_VERSION=v25.0

# Optional: the restaurant's own WhatsApp number (E.164, no leading +).
# Loop guard — messages from this number are never auto-replied to.
#BUSINESS_WA_ID=4915...
