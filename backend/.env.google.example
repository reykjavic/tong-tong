# Google OAuth — admin dashboard login (LOCAL ONLY, gitignored).
#
# Copy this file to backend/.env.google and fill in your real values:
#   cp backend/.env.google.example backend/.env.google
#
# Where the values come from (Google Cloud Console, plan Step 0):
#   GOOGLE_CLIENT_ID     Credentials -> OAuth client ID -> Web application
#   GOOGLE_CLIENT_SECRET the secret shown once at client creation
#   ADMIN_EMAIL          the Google account allowed into /dashboard
#   SITE_URL             the SPA origin the OAuth callback redirects back to
#
# The deploy script (scripts/deploy-backend.sh) reads this file and passes the
# values as CloudFormation parameters. If the file is missing, the auth Lambda
# deploys inert (login returns 503) — fill it + redeploy to activate.

GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
ADMIN_EMAIL=247reyk@gmail.com
SITE_URL=https://d22hrnca27jxah.cloudfront.net
